<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro Simulacro Académico</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;700;900&family=Karla:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #1E3A8A;
            --secondary: #3B82F6;
            --accent: #60A5FA;
            --background: #0F172A;
            --surface: #1E293B;
            --text: #F1F5F9;
            --text-secondary: #94A3B8;
            --success: #10B981;
            --error: #EF4444;
            --warning: #F59E0B;
        }

        body {
            font-family: 'Karla', sans-serif;
            background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%);
            color: var(--text);
            min-height: 100vh;
            padding: 2rem 1rem;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
            animation: rotate 30s linear infinite;
            pointer-events: none;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .container {
            max-width: 700px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .header {
            text-align: center;
            margin-bottom: 3rem;
            animation: fadeInDown 0.8s ease-out;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header h1 {
            font-family: 'Outfit', sans-serif;
            font-weight: 900;
            font-size: clamp(2rem, 5vw, 3.5rem);
            background: linear-gradient(135deg, var(--accent) 0%, var(--secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .header p {
            color: var(--text-secondary);
            font-size: 1.1rem;
            font-weight: 400;
        }

        .form-card {
            background: var(--surface);
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(96, 165, 250, 0.2);
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-section {
            margin-bottom: 2rem;
        }

        .form-section h2 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--accent);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-section h2::before {
            content: '';
            width: 4px;
            height: 24px;
            background: var(--secondary);
            border-radius: 2px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text);
            font-weight: 600;
            font-size: 0.95rem;
        }

        .required {
            color: var(--secondary);
        }

        input[type="text"],
        input[type="email"],
        select {
            width: 100%;
            padding: 0.9rem 1.2rem;
            background: var(--background);
            border: 2px solid rgba(96, 165, 250, 0.3);
            border-radius: 12px;
            color: var(--text);
            font-size: 1rem;
            font-family: 'Karla', sans-serif;
            transition: all 0.3s ease;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(96, 165, 250, 0.15);
            transform: translateY(-2px);
        }

        select {
            cursor: pointer;
            appearance: none;
            background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%2360A5FA' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: right 1.2rem center;
            padding-right: 3rem;
        }

        .radio-group {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .radio-option {
            display: flex;
            align-items: center;
            padding: 0.9rem 1.2rem;
            background: var(--background);
            border: 2px solid rgba(96, 165, 250, 0.3);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .radio-option:hover {
            border-color: var(--accent);
            transform: translateX(4px);
        }

        .radio-option input[type="radio"] {
            width: 20px;
            height: 20px;
            margin-right: 0.8rem;
            accent-color: var(--secondary);
            cursor: pointer;
        }

        .radio-option label {
            margin: 0;
            cursor: pointer;
            flex: 1;
        }

        .submit-btn {
            width: 100%;
            padding: 1.2rem;
            background: linear-gradient(135deg, var(--secondary) 0%, #2563EB 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 700;
            font-family: 'Outfit', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
            letter-spacing: 0.02em;
        }

        .submit-btn:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(59, 130, 246, 0.5);
        }

        .submit-btn:active:not(:disabled) {
            transform: translateY(-1px);
        }

        .submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .message {
            padding: 1rem 1.2rem;
            border-radius: 12px;
            margin-top: 1rem;
            font-weight: 600;
            display: none;
            animation: slideIn 0.4s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message.success {
            background: rgba(78, 205, 196, 0.15);
            color: var(--success);
            border: 2px solid var(--success);
            display: block;
        }

        .message.error {
            background: rgba(255, 107, 107, 0.15);
            color: var(--error);
            border: 2px solid var(--error);
            display: block;
        }

        .info-box {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(30, 58, 138, 0.1) 100%);
            border: 2px solid var(--secondary);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            animation: fadeInUp 0.8s ease-out 0.1s both;
        }

        .info-box h3 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--accent);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .info-box h3::before {
            content: 'ⓘ';
            font-size: 1.5rem;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 0.8rem;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .info-item:last-child {
            margin-bottom: 0;
        }

        .info-item::before {
            content: '▸';
            color: var(--accent);
            margin-right: 0.6rem;
            font-weight: bold;
            flex-shrink: 0;
        }

        .warning-box {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.1) 100%);
            border: 2px solid var(--warning);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            animation: fadeInUp 0.8s ease-out 0.15s both;
        }

        .warning-box h3 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--warning);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .warning-box h3::before {
            content: '⚠';
            font-size: 1.5rem;
        }

        .warning-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 0.8rem;
            font-size: 0.95rem;
            line-height: 1.6;
            color: var(--text-secondary);
        }

        .warning-item:last-child {
            margin-bottom: 0;
        }

        .warning-item::before {
            content: '•';
            color: var(--warning);
            margin-right: 0.6rem;
            font-weight: bold;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .highlight {
            color: var(--accent);
            font-weight: 600;
        }

        .deadline {
            color: var(--warning);
            font-weight: 700;
        }

        @media (max-width: 640px) {
            body {
                padding: 1rem 0.5rem;
            }

            .form-card {
                padding: 1.5rem;
                border-radius: 16px;
            }

            .header h1 {
                font-size: 2rem;
            }
        }

        .footer {
            text-align: center;
            margin-top: 2rem;
            padding: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
            animation: fadeIn 1s ease-out 0.5s both;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .footer a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .footer a:hover {
            color: var(--secondary);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Registro de Simulacro</h1>
            <p>Asegura tu lugar - Cupos limitados disponibles</p>
        </div>

        <div class="form-card">
            <!-- Información Importante -->
            <div class="info-box">
                <h3>Información del Simulacro</h3>
                <div class="info-item">
                    <span><span class="highlight">Cupos limitados</span> - Registra tu participación cuanto antes</span>
                </div>
                <div class="info-item">
                    <span>Cierre de registro: <span class="deadline">Jueves 19 de febrero</span></span>
                </div>
                <div class="info-item">
                    <span>Fecha de aplicación: <span class="highlight">Sábado 21 de febrero a las 6:30 AM</span></span>
                </div>
            </div>

            <!-- Requisitos y Advertencias -->
            <div class="warning-box">
                <h3>Requisitos Importantes</h3>
                <div class="warning-item">
                    <span>No se permiten dispositivos móviles, relojes o dispositivos electrónicos durante el simulacro</span>
                </div>
                <div class="warning-item">
                    <span>Se podrá excluir a estudiantes que no hayan cumplido con las tareas de Duolingo</span>
                </div>
            </div>

            <form id="registroForm">
                <!-- Datos Personales -->
                <div class="form-section">
                    <h2>Datos Personales</h2>
                    
                    <div class="form-group">
                        <label for="nombres">Nombres <span class="required">*</span></label>
                        <input type="text" id="nombres" name="nombres" required>
                    </div>

                    <div class="form-group">
                        <label for="apellidos">Apellidos <span class="required">*</span></label>
                        <input type="text" id="apellidos" name="apellidos" required>
                    </div>

                    <div class="form-group">
                        <label for="email">Correo Electrónico <span class="required">*</span></label>
                        <input type="email" id="email" name="email" required>
                    </div>
                </div>

                <!-- Información Socioeconómica -->
                <div class="form-section">
                    <h2>Información Socioeconómica</h2>

                    <div class="form-group">
                        <label>¿Tienes acceso a internet en casa? <span class="required">*</span></label>
                        <div class="radio-group">
                            <div class="radio-option">
                                <input type="radio" id="internet-si" name="internet" value="Sí" required>
                                <label for="internet-si">Sí</label>
                            </div>
                            <div class="radio-option">
                                <input type="radio" id="internet-no" name="internet" value="No">
                                <label for="internet-no">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>¿Tienes dispositivo propio para estudiar? <span class="required">*</span></label>
                        <div class="radio-group">
                            <div class="radio-option">
                                <input type="radio" id="dispositivo-si" name="dispositivo" value="Sí, computadora" required>
                                <label for="dispositivo-si">Sí, computadora</label>
                            </div>
                            <div class="radio-option">
                                <input type="radio" id="dispositivo-tablet" name="dispositivo" value="Sí, tablet">
                                <label for="dispositivo-tablet">Sí, tablet</label>
                            </div>
                            <div class="radio-option">
                                <input type="radio" id="dispositivo-celular" name="dispositivo" value="Sí, solo celular">
                                <label for="dispositivo-celular">Sí, solo celular</label>
                            </div>
                            <div class="radio-option">
                                <input type="radio" id="dispositivo-no" name="dispositivo" value="No">
                                <label for="dispositivo-no">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>¿Cuántas personas viven en tu hogar? <span class="required">*</span></label>
                        <select id="personas" name="personas" required>
                            <option value="">Selecciona una opción</option>
                            <option value="1-2">1-2 personas</option>
                            <option value="3-4">3-4 personas</option>
                            <option value="5-6">5-6 personas</option>
                            <option value="7+">7 o más personas</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Nivel educativo de tu madre/padre o tutor <span class="required">*</span></label>
                        <select id="educacion" name="educacion" required>
                            <option value="">Selecciona una opción</option>
                            <option value="Primaria">Primaria</option>
                            <option value="Secundaria">Secundaria</option>
                            <option value="Técnico">Técnico</option>
                            <option value="Universitario">Universitario</option>
                            <option value="Posgrado">Posgrado</option>
                            <option value="No sé">No sé</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn">
                    Registrar Participación
                </button>

                <div id="message" class="message"></div>
            </form>
        </div>

        <div class="footer">
            Desarrollado por <strong>Froylan Jiménez</strong>
        </div>
    </div>

    <script>
        // IMPORTANTE: Reemplaza esta URL con la URL de tu Google Apps Script
        const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbz1yWNyPXZtaluQriPD5UWI6yB5opoCHWbcsCCVRsHHnPQ2AnIhenmrIU23JBAeOHoy/exec';

        const form = document.getElementById('registroForm');
        const submitBtn = document.getElementById('submitBtn');
        const messageDiv = document.getElementById('message');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Deshabilitar botón
            submitBtn.disabled = true;
            submitBtn.textContent = 'Enviando...';
            messageDiv.style.display = 'none';

            // Recopilar datos del formulario
            const formData = new FormData(form);
            const data = {
                timestamp: new Date().toLocaleString('es-ES'),
                nombres: formData.get('nombres'),
                apellidos: formData.get('apellidos'),
                email: formData.get('email'),
                grado: '11vo', // Todos son de undécimo grado
                internet: formData.get('internet'),
                dispositivo: formData.get('dispositivo'),
                personas: formData.get('personas'),
                educacion: formData.get('educacion')
            };

            try {
                const response = await fetch(SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                });

                // Con mode: 'no-cors', no podemos leer la respuesta
                // Asumimos que fue exitoso si no hay error
                messageDiv.className = 'message success';
                messageDiv.textContent = '¡Registro exitoso! Gracias por inscribirte al simulacro.';
                messageDiv.style.display = 'block';
                form.reset();

            } catch (error) {
                console.error('Error:', error);
                messageDiv.className = 'message error';
                messageDiv.textContent = 'Hubo un error al enviar el formulario. Por favor, intenta nuevamente.';
                messageDiv.style.display = 'block';
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Registrar Participación';
            }
        });
    </script>
</body>
</html>
